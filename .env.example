# Local development environment. Never commit a real .env file.
# Use a public HTTPS origin for APP_URL when creating real Duitku invoices.
APP_URL=https://your-public-domain.example

# Duitku POP configuration for local Express fallback.
# Leave empty until valid Sandbox merchant credentials are configured.
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Callback signature key documented by Duitku as merchantKey.
# Keep separate from DUITKU_API_KEY until the merchant contract confirms whether they are identical.
DUITKU_MERCHANT_KEY=

# Admin API: required for the local Express admin routes.
# Use a long random value; there is no default PIN.
ADMIN_SECRET_PIN=

# Optional Gemini integration.
GEMINI_API_KEY=

# Supabase Edge Function settings are configured separately in Supabase Secrets.
# Do NOT add service-role credentials to VITE_* variables or browser code.
# Optional Edge Function URL overrides; set as Supabase secrets, not frontend env:
# DUITKU_CALLBACK_URL=https://your-public-domain.example/api/duitku-callback
# DUITKU_RETURN_URL=https://your-public-domain.example/orders
