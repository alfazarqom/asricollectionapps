{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/products",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-products"
    },
    {
      "source": "/api/products/(.*)",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-products"
    },
    {
      "source": "/api/create-invoice",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/duitku-create-invoice"
    },
    {
      "source": "/api/duitku-callback",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/duitku-callback"
    },
    {
      "source": "/api/duitku-check-status",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-duitku-payment-status"
    },
    {
      "source": "/api/admin/auth",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/admin-api?action=auth"
    },
    {
      "source": "/api/admin/metrics",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/admin-api?action=metrics"
    },
    {
      "source": "/api/admin/orders",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/admin-api?action=orders"
    },
    {
      "source": "/api/admin/orders/:orderNumber/shipping",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/admin-api?action=shipping&orderNumber=:orderNumber"
    },
    {
      "source": "/api/orders/track",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-order-tracking"
    },
    {
      "source": "/api/orders/:orderNumber",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-duitku-payment-status?orderNumber=:orderNumber"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "https://mvwflakurihhakdrlteg.supabase.co/functions/v1/get-duitku-payment-status"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
