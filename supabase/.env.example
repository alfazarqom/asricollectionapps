# ==============================================================================
# SUPABASE EDGE FUNCTIONS SECRETS TEMPLATE
# Letakkan konfigurasi ini khusus untuk Supabase (bukan untuk AI Studio)
#
# Perintah CLI untuk mengunggah seluruh secret ke Supabase:
#   supabase secrets set --env-file supabase/.env
#
# Perintah CLI untuk memeriksa secret yang sudah tersimpan:
#   supabase secrets list
# ==============================================================================

# 1. Kredensial Duitku Merchant (Sandbox / Production)
DUITKU_MERCHANT_CODE="D12345"
DUITKU_API_KEY="your_duitku_merchant_api_key_here"
DUITKU_ENV="sandbox"

# 2. URL Webhook & Redirect
DUITKU_CALLBACK_URL="https://mvwflakurihhakdrlteg.supabase.co/functions/v1/duitku-callback"
DUITKU_RETURN_URL="https://your-app-domain.com/orders"

# 3. Kredensial Internal Supabase
SUPABASE_URL="https://mvwflakurihhakdrlteg.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# 4. Host Aplikasi
APP_URL="https://your-app-domain.com"
